# ==========================================
# Evora MERN Stack - Comprehensive .gitignore
# ==========================================

# 1. Dependency Directories
node_modules/
server/node_modules/
client/node_modules/

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
server/.env.local
client/.env
client/.env.local
*.env

# 3. Build & Distribution Outputs
dist/
dist-ssr/
build/
client/dist/
client/dist-ssr/
client/build/

# 4. Vite Cache & Temporary Files
.vite/
.vite_cache/
client/.vite/
client/.vite_cache/
*.tsbuildinfo

# 5. Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Uploads, Temp Files & Coverage
uploads/
server/uploads/
tmp/
temp/
coverage/
.nyc_output/

# 7. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 8. IDE & Editor Specific Folders
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
