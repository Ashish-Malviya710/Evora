# Backend Environment Variables Template
PORT=5000
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/evora?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Optional)
GEMINI_API_KEY=your_google_gemini_api_key

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer Credentials for OTPs (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
